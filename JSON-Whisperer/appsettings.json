{
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ModelName": "mistral",
    "EmbeddingModel": "nomic-embed-text",
    "TimeoutSeconds": 30,
    "RetryAttempts": 3,
    "RetryDelaySeconds": 2,
    "MaxConcurrentRequests": 5,
    "EnableHealthCheck": true,
    "HealthCheckIntervalSeconds": 60
  },
  "Application": {
    "VerboseMode": false,
    "MaxJsonSizeBytes": 10485760,
    "EnablePerformanceMetrics": true,
    "OutputFormat": "standard",
    "EnableCaching": true,
    "CacheExpirationMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "JSON_Whisperer": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    },
    "Console": {
      "IncludeScopes": false,
      "TimestampFormat": "yyyy-MM-dd HH:mm:ss"
    },
    "File": {
      "Enabled": false,
      "Path": "logs/json-whisperer.log",
      "MaxFileSizeBytes": 5242880,
      "MaxFiles": 5
    }
  },
  "Performance": {
    "EnableTiming": true,
    "EnableMemoryTracking": false,
    "WarnOnSlowOperationsMs": 5000,
    "MaxMemoryUsageMB": 1024,
    "EnableGarbageCollectionMetrics": false
  },
  "Vector": {
    "SimilarityThreshold": 0.7,
    "MaxSimilarResults": 5,
    "EnableSimilarityMatching": true,
    "AppDataPath": "AppData",
    "InitializeKnowledgeBase": true,
    "EmbeddingDimensions": 768,
    "BatchSize": 100,
    "CacheEmbeddings": true,
    "EmbeddingCacheExpirationHours": 24,
    "MinSimilarityScore": 0.5,
    "MaxEmbeddingRetries": 3,
    "EmbeddingRetryDelayMs": 1000,
    "EnableVectorCompression": false,
    "VectorNormalization": "L2"
  },
  "ScyllaDb": {
    "ContactPoints": "127.0.0.1",
    "Port": 9042,
    "Keyspace": "json_whisperer",
    "Username": "",
    "Password": "",
    "DataCenter": "datacenter1",
    "ConnectionTimeoutSeconds": 10,
    "QueryTimeoutSeconds": 30,
    "CreateKeyspaceIfNotExists": true,
    "ReplicationFactor": 1,
    "ConsistencyLevel": "LocalQuorum",
    "MaxConnectionsPerHost": 8,
    "MaxRequestsPerConnection": 32768,
    "HeartbeatIntervalSeconds": 30,
    "IdleTimeoutSeconds": 600,
    "EnableCompression": true,
    "CompressionType": "LZ4",
    "EnableSSL": false,
    "SSLCertificatePath": "",
    "SSLKeyPath": "",
    "LoadBalancingPolicy": "DCAwareRoundRobin",
    "RetryPolicy": "DefaultRetryPolicy",
    "ReconnectionPolicy": "ExponentialReconnectionPolicy",
    "SpeculativeExecutionPolicy": "ConstantSpeculativeExecutionPolicy",
    "PoolingOptions": {
      "CoreConnectionsPerHost": 2,
      "MaxConnectionsPerHost": 8,
      "MaxRequestsPerConnection": 32768,
      "NewConnectionThreshold": 800
    }
  },
  "EnvironmentVariables": {
    "_comment": "Environment variable examples for deployment - these are not used by the application but serve as documentation",
    "OLLAMA_BASE_URL": "Override Ollama:BaseUrl",
    "OLLAMA_MODEL_NAME": "Override Ollama:ModelName", 
    "OLLAMA_EMBEDDING_MODEL": "Override Ollama:EmbeddingModel",
    "SCYLLADB_CONTACT_POINTS": "Override ScyllaDb:ContactPoints (comma-separated)",
    "SCYLLADB_PORT": "Override ScyllaDb:Port",
    "SCYLLADB_KEYSPACE": "Override ScyllaDb:Keyspace",
    "SCYLLADB_USERNAME": "Override ScyllaDb:Username",
    "SCYLLADB_PASSWORD": "Override ScyllaDb:Password",
    "SCYLLADB_DATACENTER": "Override ScyllaDb:DataCenter",
    "VECTOR_SIMILARITY_THRESHOLD": "Override Vector:SimilarityThreshold",
    "VECTOR_MAX_SIMILAR_RESULTS": "Override Vector:MaxSimilarResults",
    "VECTOR_ENABLE_SIMILARITY_MATCHING": "Override Vector:EnableSimilarityMatching",
    "APPLICATION_VERBOSE_MODE": "Override Application:VerboseMode",
    "APPLICATION_MAX_JSON_SIZE_BYTES": "Override Application:MaxJsonSizeBytes",
    "LOGGING_LEVEL": "Override Logging:LogLevel:Default"
  }
}